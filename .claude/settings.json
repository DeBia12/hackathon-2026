{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(node .claude/skills/a11y-check/contrast.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Read(//c/Users/**)",
      "Edit(app/**)",
      "Edit(agents/**)",
      "Edit(backend/**)",
      "Edit(presentazione/**)",
      "Edit(docs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/supabase/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "env": {
    "ANTHROPIC_MODEL": "claude-opus-5"
  }
}