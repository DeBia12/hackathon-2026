# ============================================================
#  Hackathon - variabili d'ambiente (copia in .env e compila)
#  cp .env.example .env
# ============================================================

# --- Anthropic / Claude ---
# Usata dagli agenti in agents/ e dal backend. MAI esporla al frontend.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase self-hosted (locale, Podman) ---
# Valori generati da backend/supabase/.env - vedi backend/supabase/README.md
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite: solo variabili VITE_* arrivano al browser) ---
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787
