{
  "name": "hackathon",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo hackathon — accessibilità, educazione finanziaria e digitale inclusiva",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "lint": "npm --prefix app run lint",
    "typecheck": "npm --prefix app run typecheck",
    "check": "npm run typecheck && npm run lint && npm run build",
    "present": "npx --yes serve presentation -l 8000",
    "db:up": "bash backend/supabase/scripts/up.sh",
    "db:down": "bash backend/supabase/scripts/down.sh",
    "db:reset": "bash backend/supabase/scripts/reset.sh",
    "db:psql": "bash backend/supabase/scripts/psql.sh",
    "db:logs": "bash backend/supabase/scripts/logs.sh",
    "setup": "npm --prefix app install",
    "db:setup": "bash backend/supabase/scripts/setup.sh",
    "guida": "npm run alberatura && npx --yes serve presentation/guida -l 8001 --no-clipboard",
    "alberatura": "node .claude/scripts/genera-alberatura.mjs",
    "frontiera": "node .claude/scripts/frontiera.mjs",
    "contrasto": "node .claude/skills/accessibilita/contrast.mjs"
  },
  "devDependencies": {
    "reveal.js": "^5.2.1"
  }
}
